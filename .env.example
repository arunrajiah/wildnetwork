DATABASE_URL=postgres://wildnetwork:wildnetwork@localhost:5433/wildnetwork
# Optional: protects /api/cron/pull. Vercel Cron sends it automatically.
CRON_SECRET=
# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX). Visitors are asked before anything is loaded.
NEXT_PUBLIC_GA_ID=
# Optional: the Ask box (answers questions with an AI model through the Vercel AI Gateway).
# On Vercel no key is needed: the platform supplies a short lived token. Elsewhere set AI_GATEWAY_API_KEY in your host's secret store, never in a file that is committed.
ASK_ENABLED=
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACKS=
ASK_DAILY_LIMIT=
