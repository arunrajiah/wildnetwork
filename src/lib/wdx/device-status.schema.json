{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arunrajiah/wildlife-detection-exchange/schema/device-status.schema.json",
  "title": "WDX Device Status",
  "description": "A health report from a monitoring device: battery, storage, temperature, connectivity and backlog. Wildlife Detection Exchange (WDX) v0.2. Carries no detections and no location unless the operator chooses to send one.",
  "type": "object",
  "required": ["wdx", "kind", "deviceId", "at"],
  "properties": {
    "wdx": { "type": "string", "const": "0.2" },
    "kind": { "type": "string", "const": "device-status" },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 128, "description": "The device's id at the receiving system, or the producer's stable station id." },
    "at": { "type": "string", "format": "date-time", "description": "When the report was taken, ISO 8601 with offset." },
    "battery": {
      "type": "object",
      "properties": {
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "volts": { "type": "number", "minimum": 0 },
        "charging": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "properties": {
        "freeMb": { "type": "integer", "minimum": 0 },
        "totalMb": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "temperatureC": { "type": "number", "description": "Device (CPU or enclosure) temperature." },
    "uptimeSeconds": { "type": "integer", "minimum": 0 },
    "network": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Free text. Suggested: 4g, wifi, ethernet, lora, none." },
        "signalDbm": { "type": "number" }
      },
      "additionalProperties": true
    },
    "queue": {
      "type": "object",
      "properties": { "pending": { "type": "integer", "minimum": 0, "description": "Detections recorded but not yet delivered." } },
      "additionalProperties": true
    },
    "software": {
      "type": "object",
      "description": "Component name to version, e.g. {\"wdx-agent\": \"0.3.0\", \"birdnet-go\": \"0.6.2\"}.",
      "additionalProperties": { "type": "string" }
    },
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
